# Skopiuj do `.env.local` (nigdy do repozytorium) i uzupełnij.
# Zmienne publiczne trafiają z tego pliku do `apps/web/.env.local` i `apps/mobile/.env.local`
# przez `scripts/sync-env.mjs` (uruchamia go `npm run web` / `npm run mobile`). Na produkcji
# web bierze je ze zmiennych projektu Vercel. Klucze serwerowe (OAuth Google, VAPID, sekret
# Email Workera) są sekretami Supabase Edge Functions, nie tego pliku.

# --- Supabase (Settings → API) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
# Tylko skrypty lokalne (seed, testy synchronizacji) — nigdy w aplikacji ani w webie:
SUPABASE_SERVICE_ROLE_KEY=

# --- Web Push (klucz publiczny VAPID; prywatny jest sekretem Edge Functions) ---
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
