{
  "name": "@taskplanner/sync",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./node": "./src/adapters/node.ts",
    "./expo": "./src/adapters/expo.ts",
    "./wasm": "./src/adapters/wasm.ts",
    "./wasm-worker": "./src/adapters/wasm-worker.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:integration": "vitest run --config vitest.integration.config.ts --passWithNoTests"
  },
  "dependencies": {
    "@sqlite.org/sqlite-wasm": "^3.54.1-build1",
    "@supabase/supabase-js": "^2.118.0",
    "@taskplanner/core": "*",
    "@taskplanner/db": "*"
  },
  "devDependencies": {
    "@types/node": "^24",
    "typescript": "~6.0.3",
    "vitest": "^5.0.5"
  }
}
