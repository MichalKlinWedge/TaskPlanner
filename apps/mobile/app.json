{
  "expo": {
    "name": "TaskPlanner",
    "slug": "taskplanner",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "taskplanner",
    "userInterfaceStyle": "automatic",
    "android": {
      "package": "pl.taskplanner.app",
      "predictiveBackGestureEnabled": false
    },
    "plugins": ["expo-router", "expo-sqlite"],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "runtimeVersion": {
      "policy": "appVersion"
    }
  }
}
