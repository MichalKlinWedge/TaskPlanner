{
  "expo": {
    "name": "Task Planner",
    "slug": "taskplanner",
    "version": "0.1.10",
    "orientation": "portrait",
    "scheme": "taskplanner",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/images/icon.png",
    "android": {
      "package": "pl.taskplanner.app",
      "versionCode": 11,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.SCHEDULE_EXACT_ALARM",
        "android.permission.USE_EXACT_ALARM",
        "android.permission.REQUEST_INSTALL_PACKAGES"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "monochromeImage": "./assets/images/adaptive-icon-monochrome.png",
        "backgroundColor": "#4F46E5"
      }
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 160,
          "resizeMode": "contain",
          "backgroundColor": "#FAFAFA",
          "dark": { "backgroundColor": "#09090B" }
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#2563eb"
        }
      ],
      [
        "expo-calendar",
        {
          "calendarPermission": "Task Planner pokazuje wydarzenia z kalendarza obok zadań."
        }
      ],
      [
        "react-native-android-widget",
        {
          "widgets": [
            {
              "name": "Today",
              "label": "Task Planner — Dziś",
              "description": "Zadania na dziś z odhaczaniem",
              "minWidth": "250dp",
              "minHeight": "180dp",
              "targetCellWidth": 4,
              "targetCellHeight": 3,
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 1800000
            },
            {
              "name": "QuickAdd",
              "label": "Task Planner — Szybkie dodawanie",
              "description": "Dodaj zadanie albo podyktuj je mikrofonem klawiatury",
              "minWidth": "250dp",
              "minHeight": "50dp",
              "targetCellWidth": 4,
              "targetCellHeight": 1,
              "resizeMode": "horizontal",
              "updatePeriodMillis": 1800000
            },
            {
              "name": "Habits",
              "label": "Task Planner — Nawyki",
              "description": "Dzisiejsze nawyki do odhaczenia",
              "minWidth": "250dp",
              "minHeight": "110dp",
              "targetCellWidth": 4,
              "targetCellHeight": 2,
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 1800000
            }
          ]
        }
      ],
      [
        "expo-share-intent",
        {
          "androidIntentFilters": [
            "text/*"
          ],
          "disableIOS": true
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "Task Planner robi zdjęcia do załączników zadań.",
          "microphonePermission": false
        }
      ],
      "expo-web-browser",
      "expo-background-task",
      "./plugins/app-shortcuts",
      "./plugins/local-cleartext"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "runtimeVersion": {
      "policy": "appVersion"
    }
  }
}
