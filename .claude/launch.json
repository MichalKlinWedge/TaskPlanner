      "port": 3000,
      "autoPort": true
    },
    {
      "name": "web-local-3010",
      "runtimeExecutable": "node",
      "runtimeArgs": ["scripts/dev-alt.mjs", "--local", "--port", "3010"],
      "port": 3010
