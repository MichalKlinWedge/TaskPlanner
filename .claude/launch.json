    {
      "name": "web-local-prod-3011",
      "runtimeExecutable": "node",
      "runtimeArgs": ["scripts/dev-alt.mjs", "--local", "--port", "3011", "--prod"],
      "port": 3011
    },
    {
      "name": "mobile-metro-8082",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "start", "--workspace", "apps/mobile", "--", "--port", "8082"],
      "port": 8082
    },
    {
      "name": "web-local",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "web:local"],
      "port": 3000
