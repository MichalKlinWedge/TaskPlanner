{
  "name": "taskplanner",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*",
    "tools/*"
  ],
  "scripts": {
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "check": "npm run typecheck && npm run lint && npm run test",
    "web": "node scripts/sync-env.mjs && npm run dev --workspace apps/web",
    "web:local": "node scripts/sync-env.mjs --local && npm run dev --workspace apps/web",
    "env:sync": "node scripts/sync-env.mjs",
    "mobile": "node scripts/sync-env.mjs && npm run start --workspace apps/mobile",
    "supabase": "npx --yes supabase@2.122.0",
    "test:sync": "npm run test:integration --workspace packages/sync",
    "test:e2e": "npm run test:e2e --workspace tools/e2e --",
    "perf": "npm run perf --workspace tools/e2e --",
    "perf:canvas": "npm run perf:canvas --workspace tools/e2e --",
    "test:mobile": "npm run test:mobile --workspace tools/e2e --",
    "test:db": "npx --yes supabase@2.122.0 test db",
    "seed:dev": "npm run seed --workspace tools/seed-dev --",
    "brand": "node scripts/brand.mjs",
    "web:version": "node scripts/web-version.mjs",
    "dev:user": "npm run dev-user --workspace tools/seed-dev"
  },
  "engines": {
    "node": ">=22"
  }
}
